# Copy this file to .env and fill it in. Never commit .env.

# Port the server listens on
PORT=3000

# Gemini (Google AI Studio key): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for research and Jigyasa. Change it if Google renames or retires this one.
GEMINI_MODEL=gemini-2.5-flash
# Optional: cap on output tokens, and thinking budget (0 turns thinking off on models that allow it)
# GEMINI_MAX_TOKENS=32768
# GEMINI_THINKING_BUDGET=

# Google sign-in: a "Web application" OAuth client ID from Google Cloud Console.
# Add your site origin (for example http://localhost:3000 and your real domain)
# under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Optional: only these Google accounts may sign in (comma separated). Leave empty to allow any Google account.
# ALLOWED_EMAILS=you@gmail.com,friend@gmail.com

# Local testing without Google. Never use on a public server.
# DEV_LOGIN=1

# Set to 1 when the site is served over https (marks the session cookie Secure)
# COOKIE_SECURE=1

# Max Gemini calls per user per 10 minutes
# RATE_MAX=30

# Where history and share links are stored
# DATA_FILE=./data/db.json
